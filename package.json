{
  "name": "sovra-remote-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@ubjs/core": "^0.31.0-7",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "sovra-remote": "file:modules/sovra-remote",
    "uniffi-bindgen-react-native": "^0.31.0-7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test && npm run rust:test",
    "rust:test": "cargo test --manifest-path modules/sovra-remote/rust/Cargo.toml",
    "native:android": "npm --prefix modules/sovra-remote run ubrn:android",
    "native:ios": "npm --prefix modules/sovra-remote run ubrn:ios",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/modules/",
      "/__tests__/fake-desktop.ts"
    ]
  },
  "license": "LicenseRef-SustainableUse-1.0"
}
